WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
HOST=127.0.0.1
PORT=3001
# Add real deployment addresses only after verification.
MANDATE_ADDRESS=
REGISTRY_ADDRESS=
# Keep keys in separate service-specific secret stores. Never expose them to Next.js.
# Exact Mandate deployment block: observer must backfill from deployment.
DEPLOYMENT_BLOCK=
TRUSTED_PROXY_IPS=
# World OIDC (Agent Pass). WORLD_ENV=sandbox|production picks the issuer; WORLD_ISSUER must match if set.
WORLD_ENV=sandbox
WORLD_ISSUER=
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=
WORLD_ACR=
# ENS (Sepolia only; identity/policy layer, Whitechain does not read ENS)
ENS_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ENS_AGENT_NAME=agent1.countersign.eth
# ens-setup.mjs only (signing via Foundry keystore account name, never a raw key)
ENS_KEYSTORE_ACCOUNT=
ENS_PARENT_NAME=
ENS_AGENT_LABEL=
ENS_USER_REGISTRY=
ENS_AGENT_RESOLVER=
ENS_OWNER_ADDRESS=
ENS_AGENT_ADDRESS=
ENS_ATTESTOR_ADDRESS=
ENS_MANDATE_ADDRESS=
ENS_MANDATE_ID=
ENS_MERCHANTS_HASH=
ENS_POLICY_LIMITS={"perTx":"0","daily":"0"}
WEB_TRUSTED_HOPS=1
