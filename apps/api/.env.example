WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=http://127.0.0.1:3001/auth/world/callback
# Configure only if supported by the issuer/test identity.
WORLD_ACR=
# Shared only with the separate loopback attestor, never the frontend.
ATTESTOR_HMAC_SECRET=
# Explicit testnet relaying. Dedicated signer: no other process may use its nonce.
RELAYER_ENABLED=0
RELAYER_KEY=
RELAYER_PAUSED=0
GASGUARD_DAILY_WEI=20000000000000000
GASGUARD_MANDATE_DAILY_WEI=20000000000000000
# Whitechain testnet base fee was 5 gwei (observed 2026-11-06); 1 gwei rejected every pay().
GASGUARD_MAX_FEE_WEI=10000000000
# Read-only invalidation stream; allowed browser origins, comma-separated, exact.
WEBSOCKET_ENABLED=0
WEBSOCKET_ORIGINS=http://127.0.0.1:3000
